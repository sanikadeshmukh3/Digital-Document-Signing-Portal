# ============================================================
# Database Build Configuration
# ============================================================
#
# Copy this file to:
#
#   build/.env
#
# before running the build.
#
# DO NOT place real passwords or tokens in this example file.
# DO NOT commit build/.env.
# ============================================================


# ------------------------------------------------------------
# MySQL connection
# ------------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306

DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=replace_with_local_secret


# ------------------------------------------------------------
# GitHub
# ------------------------------------------------------------
# Leave empty for a public repository.
#
# Required only if repository authentication is necessary.

GITHUB_TOKEN=


# ------------------------------------------------------------
# Build safety
# ------------------------------------------------------------
#
# NO:
#   refuse to replace an existing database
#
# YES:
#   allow intentional drop/recreation of an existing database

ALLOW_DATABASE_RECREATE=NO


# ------------------------------------------------------------
# Optional workspace
# ------------------------------------------------------------

WORK_ROOT=.build-work